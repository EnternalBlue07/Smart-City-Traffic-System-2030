# Smart Traffic Management System - Environment Configuration

# Flask Settings
SECRET_KEY=your-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# SocketIO Settings
SOCKETIO_MESSAGE_QUEUE=
SOCKETIO_ASYNC_MODE=threading

# Database
DATABASE_PATH=database/violations.db

# Session Configuration
SESSION_LIFETIME=86400
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CORS Settings
CORS_ORIGINS=*

# File Upload
MAX_CONTENT_LENGTH=524288000
UPLOAD_FOLDER=uploads

# SMS API Configuration (for fine notifications)
SMS_API_KEY=your-api-key-here
SMS_API_URL=https://textbelt.com/text

# Email Configuration (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Production Settings (set in production)
# SECRET_KEY=<generate-secure-random-key>
# FLASK_ENV=production
# FLASK_DEBUG=False
# SESSION_COOKIE_SECURE=True
# CORS_ORIGINS=https://yourdomain.com
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0
